# Desktop client
VITE_API_URL=http://localhost:3001
VITE_ROOM_ACCESS_CODE=change-me

# Token server
PORT=3001
HOST=0.0.0.0
APP_INVITE_SECRET=change-me
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
# Optional primary server. When all three values are present, the token service
# uses this deployment while retaining the LiveKit Cloud values above.
SELF_HOSTED_LIVEKIT_URL=wss://livekit.your-domain.example
SELF_HOSTED_LIVEKIT_API_KEY=your-self-hosted-api-key
SELF_HOSTED_LIVEKIT_API_SECRET=your-self-hosted-api-secret

# Packaging and automatic updates
UPDATE_BASE_URL=https://downloads.example.com/pulse-room
